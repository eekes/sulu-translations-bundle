<?xml version="1.0" encoding="utf-8"?>
<webspace xmlns="http://schemas.sulu.io/webspace/webspace"
          xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
          xsi:schemaLocation="http://schemas.sulu.io/webspace/webspace http://schemas.sulu.io/webspace/webspace-1.1.xsd">
    <name>Test</name>
    <key>test</key>

    <!-- Four locales, because a bundle whose whole point is a language switcher cannot be
         tested with one. -->
    <localizations>
        <localization language="en" default="true"/>
        <localization language="nl"/>
        <localization language="fr"/>
        <localization language="de"/>
    </localizations>

    <default-templates>
        <default-template type="page">default</default-template>
        <default-template type="home">default</default-template>
    </default-templates>

    <templates>
        <template type="search">search</template>
        <template type="error">error</template>
    </templates>

    <navigation>
        <contexts>
            <context key="main">
                <meta>
                    <title lang="en">Main</title>
                </meta>
            </context>
        </contexts>
    </navigation>

    <portals>
        <portal>
            <name>Test</name>
            <key>test</key>

            <environments>
                <environment type="prod">
                    <urls>
                        <url language="en">{host}</url>
                        <url language="nl">{host}/nl</url>
                        <url language="fr">{host}/fr</url>
                        <url language="de">{host}/de</url>
                    </urls>
                </environment>
                <environment type="test">
                    <urls>
                        <url language="en">{host}</url>
                        <url language="nl">{host}/nl</url>
                        <url language="fr">{host}/fr</url>
                        <url language="de">{host}/de</url>
                    </urls>
                </environment>
                <environment type="dev">
                    <urls>
                        <url language="en">{host}</url>
                        <url language="nl">{host}/nl</url>
                        <url language="fr">{host}/fr</url>
                        <url language="de">{host}/de</url>
                    </urls>
                </environment>
            </environments>
        </portal>
    </portals>
</webspace>
